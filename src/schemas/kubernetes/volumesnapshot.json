{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["snapshot.storage.k8s.io/v1"],
      "default": "snapshot.storage.k8s.io/v1"
    },
    "kind": {
      "type": "string",
      "enum": ["VolumeSnapshot"],
      "default": "VolumeSnapshot"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string", "default": "default" },
        "labels": { "$ref": "#/definitions/keyValuePairs" }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "volumeSnapshotClassName": { "type": "string" },
        "source": {
          "type": "object",
          "properties": {
            "persistentVolumeClaimName": { "type": "string" },
            "volumeSnapshotContentName": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "keyValuePairs": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
